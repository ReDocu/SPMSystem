# 로컬 Postgres 연결 문자열
DATABASE_URL=postgres://postgres:postgres@localhost:5432/spm

# PIN 잠금 (미설정 시 잠금 비활성 — 바로 진입)
SPM_PIN=
# 세션 쿠키 서명 키 — 임의의 긴 문자열
SPM_SECRET=

# 자동화 토큰 (선택) — 북마클릿(/api/capture)·로컬 스케줄러(/api/cron/daily)가 사용.
# 미설정 시: PIN 잠금이 없을 때만 개방
SPM_CAPTURE_TOKEN=

# 일일 요약 Discord Webhook (선택) — 로컬 스케줄러가 매일 아침
# POST /api/cron/daily?token=... 를 호출하면 이 주소로 발송된다 (기획서 §9.1)
SPM_DISCORD_WEBHOOK=

# Vercel 배포 Webhook 시크릿 (선택) — /api/webhooks/vercel 서명 검증 (상세기획 §7.3)
SPM_VERCEL_WEBHOOK_SECRET=
